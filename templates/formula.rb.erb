# typed: false
# frozen_string_literal: true

# Generated by bin/tap from tools.yml and the <%= release.tag %> release of <%= tool.repo %>.
# Do not edit: the next sync rewrites this file.
class <%= tool.class_name %> < Formula
  desc <%= q tool.desc %>
  homepage <%= q tool.homepage %>
  # Explicit: Homebrew would read "64" from archive names like x86_64.
  version <%= q release.version %>
  license <%= license_dsl %>

  livecheck do
    url :stable
    strategy :github_latest
  end

  on_macos do
    on_intel do
      url <%= q release.url(tool, "darwin_amd64") %>
      sha256 <%= q release.sha256("darwin_amd64") %>
    end
    on_arm do
      url <%= q release.url(tool, "darwin_arm64") %>
      sha256 <%= q release.sha256("darwin_arm64") %>
    end
  end

  on_linux do
    on_intel do
      url <%= q release.url(tool, "linux_amd64") %>
      sha256 <%= q release.sha256("linux_amd64") %>
    end
    on_arm do
      url <%= q release.url(tool, "linux_arm64") %>
      sha256 <%= q release.sha256("linux_arm64") %>
    end
  end

  def install
    bin.install <%= tool.binaries.map { |b| q b }.join(", ") %>
<% if tool.completions -%>
    generate_completions_from_executable(bin/<%= q tool.binaries.first %>, <%= tool.completions.map { |a| q a }.join(", ") %>)
<% end -%>
  end
<% if tool.caveats -%>

  def caveats
    <%= q tool.caveats %>
  end
<% end -%>

  test do
    assert_match version.to_s, shell_output(<%= test_command %>)
  end
end
