#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
#
# Installs a GregoireF tool on macOS or Linux, verified, without Homebrew:
#
#   curl -fsSL <%= url %>/install.sh | sh -s -- kiwa
#   curl -fsSL <%= url %>/install.sh | sh -s -- --prefix /usr/local --require-provenance ship
#
# Generated by bin/tap from the tap's tools.lock.json: the archive URLs and
# their SHA-256 are the ones the tap verified and install-tested. Every
# download is checked against that SHA-256; when the tool publishes a SLSA
# build provenance and the GitHub CLI is logged in, `gh attestation verify`
# checks it too (--require-provenance makes that mandatory).
#
# Tools: <%= served.map { |tool, release| "#{tool.name} #{release.version}" }.join(", ") %>
set -eu

usage() {
  cat <<'EOF'
usage: install.sh [--prefix DIR] [--require-provenance] TOOL

  --prefix DIR           install into DIR/bin (default: ~/.local)
  --require-provenance   fail unless the SLSA provenance could be verified
EOF
}

die() {
  printf 'install.sh: %s\n' "$*" >&2
  exit 1
}

# Sets url, sha256, repo, verified and binaries for tool $1 on platform $2.
lookup() {
  case "$1/$2" in
<% served.each do |tool, release| -%>
<% unix.each do |platform| -%>
    <%= tool.name %>/<%= platform %>)
      url=<%= sh release.url(tool, platform) %>
      sha256=<%= release.sha256(platform) %>
      repo=<%= sh tool.repo %> verified=<%= release.verified %> binaries=<%= sh tool.binaries.join(" ") %> ;;
<% end -%>
<% end -%>
    *) return 1 ;;
  esac
}

platform() {
  case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    *) die "unsupported system $(uname -s): use Scoop or WinGet on Windows" ;;
  esac
  case "$(uname -m)" in
    x86_64 | amd64) arch=amd64 ;;
    arm64 | aarch64) arch=arm64 ;;
    *) die "unsupported architecture $(uname -m)" ;;
  esac
  printf '%s_%s\n' "$os" "$arch"
}

download() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --proto '=https' --tlsv1.2 -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -q --https-only -O "$2" "$1"
  else
    die "needs curl or wget"
  fi
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d ' ' -f 1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | cut -d ' ' -f 1
  else
    die "needs sha256sum or shasum"
  fi
}

main() {
  prefix="${HOME}/.local"
  require_provenance=0
  tool=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --prefix) [ $# -ge 2 ] || die "--prefix needs a directory"; prefix="$2"; shift 2 ;;
      --require-provenance) require_provenance=1; shift ;;
      -h | --help) usage; exit 0 ;;
      -*) usage >&2; exit 2 ;;
      *) tool="$1"; shift ;;
    esac
  done
  [ -n "$tool" ] || { usage >&2; exit 2; }

  target="$(platform)"
  os="${target%_*}"
  lookup "$tool" "$target" || die "no $tool for $target (tools: <%= served.map { |t, _| t.name }.join(", ") %>)"

  work="$(mktemp -d)"
  trap 'rm -rf "$work"' EXIT INT TERM
  archive="$work/${url##*/}"
  printf 'Downloading %s\n' "$url"
  download "$url" "$archive"

  actual="$(sha256_of "$archive")"
  [ "$actual" = "$sha256" ] || die "SHA-256 mismatch for ${url##*/}: got $actual, expected $sha256"
  printf 'SHA-256 verified\n'

  if [ "$verified" != attestation ]; then
    [ "$require_provenance" -eq 0 ] || die "$tool publishes no build provenance yet: SHA-256 only"
    printf 'note: %s publishes no build provenance yet, SHA-256 only\n' "$tool" >&2
  elif command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    gh attestation verify "$archive" --repo "$repo" >/dev/null || die "no valid provenance from $repo"
    printf 'SLSA provenance verified (signed by a workflow of %s)\n' "$repo"
  elif [ "$require_provenance" -eq 1 ]; then
    die "provenance not verified: needs a logged-in GitHub CLI (gh auth login)"
  else
    printf 'warning: provenance not verified (install and log in to the GitHub CLI to check it)\n' >&2
  fi

  mkdir -p "$work/x" "$prefix/bin"
  case "$archive" in
    *.tar.xz) tar -xJf "$archive" -C "$work/x" ;;
    *) tar -xzf "$archive" -C "$work/x" ;;
  esac
  for binary in $binaries; do
    found="$(find "$work/x" -type f -name "$binary" | head -n 1)"
    [ -n "$found" ] || die "$binary not found in ${url##*/}"
    cp "$found" "$prefix/bin/$binary"
    chmod 755 "$prefix/bin/$binary"
    printf 'Installed %s\n' "$prefix/bin/$binary"
  done

  # musl systems (Alpine) run static builds only: check that it starts.
  first="${binaries%% *}"
  if [ "$os" = linux ] && ldd --version 2>&1 | grep -qi musl && ! "$prefix/bin/$first" --version >/dev/null 2>&1; then
    for binary in $binaries; do rm -f "$prefix/bin/$binary"; done
    die "$tool's Linux build needs glibc; on musl (Alpine) install gcompat first, or use Homebrew"
  fi

  case ":${PATH}:" in
    *":$prefix/bin:"*) ;;
    *) printf 'Add %s to your PATH to run %s.\n' "$prefix/bin" "$tool" ;;
  esac
}

main "$@"
