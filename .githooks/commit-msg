#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
#
# The commit header rules of ship-it (`✨ feat(scope): subject`, at most 72
# characters) and no AI co-author trailer. See .githooks/pre-commit.
set -eu
cd "$(git rev-parse --show-toplevel)"
command -v ruby >/dev/null 2>&1 || exit 0
exec ruby bin/tap lint-commit "$1"
