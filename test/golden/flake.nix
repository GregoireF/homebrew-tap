# Generated by bin/tap from tools.yml and tools.lock.json. Do not edit: the
# next sync rewrites this file.
#
#   nix run github:GregoireF/homebrew-tap#kiwa -- --version
#   nix profile install github:GregoireF/homebrew-tap#ship
#
# Every package is the prebuilt release archive the tap verified and
# install-tested, pinned by its hash.
{
  description = "GregoireF tools, prebuilt and verified (demo 1.2.3)";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";

  outputs =
    { self, nixpkgs }:
    let
      # Nix system -> the tap's platform name.
      systems = {
        "x86_64-linux" = "linux_amd64";
        "aarch64-linux" = "linux_arm64";
        "x86_64-darwin" = "darwin_amd64";
        "aarch64-darwin" = "darwin_arm64";
      };

      tools = {
        demo = {
          version = "1.2.3";
          description = "Demonstrates the tap";
          homepage = "https://github.com/GregoireF/demo";
          binaries = [ "demo" "dm" ];
          archives = {
            linux_amd64 = {
              url = "https://github.com/GregoireF/demo/releases/download/v1.2.3/demo_1.2.3_linux_amd64.tar.gz";
              hash = "sha256-bkKyNaQmxqsUmtGx9a48CJRAlXXEXUdphjADRljPCWM=";
            };
            linux_arm64 = {
              url = "https://github.com/GregoireF/demo/releases/download/v1.2.3/demo_1.2.3_linux_arm64.tar.gz";
              hash = "sha256-PnvIg5noLDISHQQVfPx6M4AcCaYL0PjGR4rbGCmvOTc=";
            };
            darwin_amd64 = {
              url = "https://github.com/GregoireF/demo/releases/download/v1.2.3/demo_1.2.3_darwin_amd64.tar.gz";
              hash = "sha256-HNz67uj/8nNLFJKbwNQGmaPKWg0HoNClz3qLRjbwFbI=";
            };
            darwin_arm64 = {
              url = "https://github.com/GregoireF/demo/releases/download/v1.2.3/demo_1.2.3_darwin_arm64.tar.gz";
              hash = "sha256-Y5n7M2NNPHCQJYYDdz8HmX4HNtzq5wlpd+g2XpOno1A=";
            };
          };
        };
      };

      package =
        pkgs: platform: name: tool:
        pkgs.stdenvNoCC.mkDerivation {
          pname = name;
          inherit (tool) version;
          src = pkgs.fetchurl tool.archives.${platform};
          sourceRoot = ".";
          # Linux builds linked against glibc get their interpreter and
          # libraries from nixpkgs; static builds are left as they are.
          nativeBuildInputs = pkgs.lib.optionals pkgs.stdenv.hostPlatform.isLinux [ pkgs.autoPatchelfHook ];
          buildInputs = pkgs.lib.optionals pkgs.stdenv.hostPlatform.isLinux [ pkgs.stdenv.cc.cc.lib ];
          dontConfigure = true;
          dontBuild = true;
          installPhase = ''
            runHook preInstall
            for binary in ${pkgs.lib.escapeShellArgs tool.binaries}; do
              found="$(find . -type f -name "$binary" | head -n 1)"
              install -Dm755 "$found" "$out/bin/$binary"
            done
            runHook postInstall
          '';
          meta = {
            inherit (tool) description homepage;
            mainProgram = builtins.head tool.binaries;
            platforms = builtins.attrNames systems;
            sourceProvenance = [ pkgs.lib.sourceTypes.binaryNativeCode ];
          };
        };
    in
    {
      packages = nixpkgs.lib.genAttrs (builtins.attrNames systems) (
        system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
        in
        nixpkgs.lib.mapAttrs (package pkgs systems.${system}) tools
      );
    };
}
