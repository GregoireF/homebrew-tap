{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gregoiref.github.io/homebrew-tap/api/v1/schema.json",
  "title": "GregoireF tap API v1",
  "description": "api/v1/tools.json (an index) and api/v1/tools/<name>.json (one tool). Generated by bin/tap site; test/api_test.rb checks the output against this file.",
  "oneOf": [{ "$ref": "#/$defs/index" }, { "$ref": "#/$defs/tool" }],
  "$defs": {
    "verified": {
      "enum": ["checksum", "attestation"],
      "description": "attestation: every archive's SLSA provenance was verified; checksum: SHA-256 against the release's checksums file."
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "desc", "version", "published", "verified", "url"],
      "properties": {
        "name": { "type": "string" },
        "desc": { "type": "string" },
        "version": { "type": "string" },
        "published": { "type": ["string", "null"], "format": "date-time" },
        "verified": { "$ref": "#/$defs/verified" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "tools"],
      "properties": {
        "$schema": { "type": "string" },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/summary" } }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "name", "desc", "homepage", "license", "version", "tag", "published", "verified",
                   "binaries", "archives", "install"],
      "properties": {
        "$schema": { "type": "string" },
        "name": { "type": "string" },
        "desc": { "type": "string" },
        "homepage": { "type": "string", "format": "uri" },
        "license": { "type": "string", "description": "SPDX expression" },
        "version": { "type": "string" },
        "tag": { "type": "string" },
        "published": { "type": ["string", "null"], "format": "date-time" },
        "verified": { "$ref": "#/$defs/verified" },
        "binaries": { "type": "array", "items": { "type": "string" } },
        "archives": {
          "type": "object",
          "additionalProperties": false,
          "required": ["darwin_amd64", "darwin_arm64", "linux_amd64", "linux_arm64", "windows_amd64", "windows_arm64"],
          "properties": {
            "darwin_amd64": { "$ref": "#/$defs/archive" },
            "darwin_arm64": { "$ref": "#/$defs/archive" },
            "linux_amd64": { "$ref": "#/$defs/archive" },
            "linux_arm64": { "$ref": "#/$defs/archive" },
            "windows_amd64": { "$ref": "#/$defs/archive" },
            "windows_arm64": { "$ref": "#/$defs/archive" }
          }
        },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": ["homebrew", "scoop", "installer"],
          "properties": {
            "homebrew": { "type": "string" },
            "scoop": { "type": "string" },
            "installer": { "type": "string" },
            "winget": { "type": "string" }
          }
        }
      }
    }
  }
}
